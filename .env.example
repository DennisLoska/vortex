# Voicebox TTS server URL
VOICEBOX_URL=http://127.0.0.1:17493

# Voice profile IDs for text-to-speech generation
VOICE_ID_EN=the_narrator_en
VOICE_ID_DE=the_narrator_de

# LLM — single source of truth is opencode.json "model"
# Override via VORTEX_MODEL if needed (e.g. opencode-go/ox-alpha-free).
OPENCODE_URL=http://localhost:4096
# Set to your opencode server password (from `cat /proc/$(pgrep -f "opencode web")/environ | tr '\0' '\n' | grep OPENCODE_SERVER_PASSWORD`)
# If empty, vortex will try without auth (will fail if server requires password)
OPENCODE_SERVER_PASSWORD=
VORTEX_MODEL=opencode-go/ox-alpha-free
# Embeddings — still via LM Studio (required for Chroma semantic search)
LLM_BASE_URL=http://localhost:1234
LLM_MODEL=qwen3.6-35b-a3b
EMBEDDING_MODEL=text-embedding-qwen3-embedding-8b

# ChromaDB
CHROMADB_URL=http://localhost:8000
CHROMADB_COLLECTION=vortex_assets

# Server
VORTEX_SERVER_PORT=3001

# Client
VITE_VORTEX_SERVER_URL=http://localhost:3001
