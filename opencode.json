{
  "$schema": "https://opencode.ai/config.json",
  "model": "lmstudio/qwen3.6-35b-a3b-claude-4.7-opus-reasoning-distilled-apex",
  "plugin": [
    "opencode-mem",
    "./plugins/caveman/plugin.js",
    "./plugins/loop/plugin.js",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "qwen3.6-35b-a3b-claude-4.7-opus-reasoning-distilled-apex": {
          "name": "Qwen3.6 35B-A3B APEX"
        },
        "qwen3.6-27b-claude-4.6-opus-reasoning-distilled-v2@q5_k_m": {
          "name": "Qwen 3.6 27B MXFP4 Q5"
        }
      }
    }
  },
  "skills": {
    "paths": [
      "/home/dennis/.cache/opencode/packages/superpowers@git+https:/github.com/obra/superpowers.git/node_modules/superpowers/skills"
    ]
  },
  "instructions": [
    "AGENTS.md",
    "~/.config/opencode/skills/caveman/SKILL.md"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "caveman-shrink": {
      "type": "local",
      "command": ["npx", "-y", "caveman-shrink"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/home/dennis/work", "/tmp"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--executablePath", "/usr/bin/chromium"],
      "enabled": true
    }
  }
}
